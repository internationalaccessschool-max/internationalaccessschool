rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasRole(r) { return isAuth() && getUserRole() == r; }
    function hasAny(roles) { return isAuth() && getUserRole() in roles; }
    function isAdmin() { return hasRole('admin'); }
    function isTeacher() { return hasRole('teacher'); }
    function isAccountantOrAdmin() { return hasAny(['admin', 'accountant']); }
    function isTeacherOrAdmin() { return hasAny(['admin', 'teacher']); }
    function isAdminOrSupervisor() { return hasAny(['admin', 'supervisor']); }
    function isStaff() { return hasAny(['admin', 'teacher', 'accountant', 'supervisor']); }
    // Supervisor monitors fees but cannot modify them
    function isFeeViewer() { return hasAny(['admin', 'accountant', 'supervisor']); }

    // ─── Users (core user docs) ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && (isStaff() || uid() == userId);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isAuth() && uid() == userId && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ─── Student profiles (nested: users/classes/…/profiles/{uid}) ────────────
    // Intermediate traversal docs — staff only
    match /users/classes/{className}/{path=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Profile documents — student reads/writes own; staff reads/writes all.
    // profileId == student UID (document ID is always set to uid on create).
    match /{path=**}/profiles/{profileId} {
      allow read: if isStaff() ||
        (isAuth() && uid() == profileId) ||
        (isAuth() && resource.data.uid == uid());
      // Student can update own profile (notificationEmail, photo etc.)
      // but cannot change class, section, or admissionNumber.
      allow write: if isStaff() || (
        isAuth() && uid() == profileId &&
        request.resource.data.className == resource.data.className &&
        request.resource.data.section == resource.data.section &&
        request.resource.data.admissionNumber == resource.data.admissionNumber
      );
    }

    // ─── Role-specific lookup collections ─────────────────────────────────────
    // Admin list — admin only
    match /admins/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Each role member reads own doc; admin manages all
    match /accountants/{docId} {
      allow read: if isAdmin() || (isAuth() && uid() == docId);
      allow write: if isAdmin();
    }
    match /supervisors/{docId} {
      allow read: if isAdmin() || (isAuth() && uid() == docId);
      allow write: if isAdmin();
    }
    match /teachers/{docId} {
      allow read: if isAdminOrSupervisor() || (isAuth() && uid() == docId);
      allow write: if isAdmin();
    }
    match /nonTeachingStaff/{docId} {
      allow read: if isAdminOrSupervisor() || (isAuth() && uid() == docId);
      allow write: if isAdmin();
    }

    // ─── Student Lookup (uid → class/section cache) ───────────────────────────
    match /studentLookup/{studentId} {
      allow read: if isStaff() || (isAuth() && uid() == studentId);
      allow write: if isStaff();
    }

    // ─── Legacy flat students collection ──────────────────────────────────────
    match /students/{document=**} {
      allow read: if isStaff() || (isAuth() && resource.data.uid == uid());
      allow write: if isStaff();
    }

    // ─── Student Attendance ───────────────────────────────────────────────────
    match /attendance/{document=**} {
      allow read: if isAuth();
      allow write: if hasAny(['admin', 'teacher', 'supervisor']);
    }

    // ─── Teacher Attendance ───────────────────────────────────────────────────
    match /teacherAttendance/{document=**} {
      allow read: if isAdminOrSupervisor() || (isAuth() && isTeacher());
      allow write: if isAdminOrSupervisor();
    }

    // ─── CollectionGroup "records" — covers feeRecords + teacherSalary queries ──
    // This explicit wildcard rule is what Firestore uses to validate
    // collectionGroup("records") queries that span multiple root collections.
    match /{path=**}/records/{recordId} {
      allow read: if isFeeViewer() || isAdminOrSupervisor() ||
        (isAuth() && resource.data.studentId == uid()) ||
        (isAuth() && isTeacher() && resource.data.teacherId == uid());
      allow write: if isAccountantOrAdmin() || isAdmin();
    }

    // ─── Monthly School Fee Records ───────────────────────────────────────────
    match /feeRecords/{year}/months/{month}/classes/{classId}/records/{recordId} {
      allow read: if isFeeViewer() || (isAuth() && resource.data.studentId == uid());
      allow write: if isAccountantOrAdmin();
    }
    match /feeRecords/{document=**} {
      allow read: if isFeeViewer();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Annual Fee Records ───────────────────────────────────────────────────
    match /annualFeeRecords/{session}/students/{studentId} {
      allow read: if isFeeViewer() || (isAuth() && uid() == studentId);
      allow write: if isAccountantOrAdmin();
    }
    match /annualFeeRecords/{document=**} {
      allow read: if isFeeViewer();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Transport Fee Records ────────────────────────────────────────────────
    match /transportFeeRecords/{year}/months/{month}/students/{studentId} {
      allow read: if isFeeViewer() || (isAuth() && uid() == studentId);
      allow write: if isAccountantOrAdmin();
    }
    match /transportFeeRecords/{document=**} {
      allow read: if isFeeViewer();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Fee Structure ────────────────────────────────────────────────────────
    match /fees/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }
    match /feeStructure/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Teacher Salary ───────────────────────────────────────────────────────
    // Supervisor can VIEW salary (read-only); only admin can write/generate.
    match /teacherSalary/{year}/months/{month}/records/{recordId} {
      allow read: if isAdminOrSupervisor() ||
        (isAuth() && isTeacher() && resource.data.teacherId == uid());
      allow write: if isAdmin();
    }
    match /teacherSalary/{document=**} {
      allow read: if isAdminOrSupervisor();
      allow write: if isAdmin();
    }

    // ─── Results / Marks ──────────────────────────────────────────────────────
    match /results/{examId}/classes/{className}/sections/{section}/students/{studentId} {
      allow read: if isAdminOrSupervisor() || isTeacherOrAdmin() ||
        (isAuth() && (uid() == studentId || resource.data.uid == uid()));
      allow write: if isTeacherOrAdmin() || isAdminOrSupervisor();
    }
    match /results/{document=**} {
      allow read: if isTeacherOrAdmin() || isAdminOrSupervisor();
      allow write: if isTeacherOrAdmin() || isAdminOrSupervisor();
    }

    // ─── Exams ────────────────────────────────────────────────────────────────
    match /exams/{document=**} {
      allow read: if isAuth();
      allow write: if isTeacherOrAdmin() || isAdminOrSupervisor();
    }

    // ─── Timetable ────────────────────────────────────────────────────────────
    match /timetable/{document=**} {
      allow read: if isAuth();
      allow write: if isAdminOrSupervisor();
    }
    match /timetableConfig/{document=**} {
      allow read: if isAuth();
      allow write: if isAdminOrSupervisor();
    }

    // ─── Classes / Subjects / Assignments ─────────────────────────────────────
    match /classes/{document=**}            { allow read: if isAuth(); allow write: if isAdminOrSupervisor(); }
    match /classSubjects/{document=**}      { allow read: if isAuth(); allow write: if isAdminOrSupervisor(); }
    match /class_teachers/{document=**}     { allow read: if isAuth(); allow write: if isAdminOrSupervisor(); }
    match /subjects/{document=**}           { allow read: if isAuth(); allow write: if isAdminOrSupervisor(); }
    match /teacherAssignments/{document=**} { allow read: if isAuth(); allow write: if isTeacherOrAdmin() || isAdminOrSupervisor(); }
    match /homework/{document=**}           { allow read: if isAuth(); allow write: if isTeacherOrAdmin() || isAdminOrSupervisor(); }

    // ─── Academic Content (public-facing) ─────────────────────────────────────
    match /notices/{document=**}            { allow read: if true; allow write: if isStaff(); }
    match /gallery/{document=**}            { allow read: if true; allow write: if isStaff(); }
    match /hero-slides/{document=**}        { allow read: if true; allow write: if isAdminOrSupervisor(); }
    match /academic_info/{document=**}      { allow read: if true; allow write: if isAdminOrSupervisor(); }
    match /academic_programs/{document=**}  { allow read: if true; allow write: if isAdminOrSupervisor(); }

    // ─── App Settings ─────────────────────────────────────────────────────────
    match /settings/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Transport ────────────────────────────────────────────────────────────
    match /transport/{document=**} {
      allow read: if isAuth();
      allow write: if hasAny(['admin', 'supervisor', 'accountant']);
    }
    match /transport_buses/{document=**} {
      allow read: if isAuth();
      allow write: if hasAny(['admin', 'supervisor', 'accountant']);
    }

    // ─── Admissions ───────────────────────────────────────────────────────────
    match /admissions/{document=**} {
      allow read: if isFeeViewer();
      allow write: if isAccountantOrAdmin();
    }
    match /admission_requests/{document=**} {
      allow read: if isAdminOrSupervisor();
      allow create: if true;
      allow update, delete: if isAdminOrSupervisor();
    }

    // ─── Job Applications (public submit) ─────────────────────────────────────
    match /job_applications/{document=**} {
      allow read: if isAdminOrSupervisor();
      allow create: if true;
      allow update, delete: if isAdminOrSupervisor();
    }

    // ─── Syllabus ─────────────────────────────────────────────────────────────
    match /syllabus/{docId} {
      allow read: if isAuth();
      allow write: if isAdminOrSupervisor() || isTeacher();
    }

    // ─── Leave Applications ───────────────────────────────────────────────────
    match /leaveApplications/{docId} {
      allow read: if isAuth() && (
        resource.data.applicantId == uid() || isAdminOrSupervisor()
      );
      allow create: if isAuth() && request.resource.data.applicantId == uid();
      allow update: if isAdminOrSupervisor();
      allow delete: if isAdminOrSupervisor();
    }

    // ─── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
