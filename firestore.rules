rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAccountantOrAdmin() {
      return isAuth() && getUserRole() in ['admin', 'accountant'];
    }

    function isTeacherOrAdmin() {
      return isAuth() && getUserRole() in ['admin', 'teacher'];
    }

    // Users — own data only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Students flat collection
    match /students/{document=**} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Students profiles subcollection (collectionGroup)
    match /{path=**}/profiles/{profileId} {
      allow read: if isAuth();
    }

    // Homework — only teachers and admins can write
    match /homework/{document=**} {
      allow read: if isAuth();
      allow write: if isTeacherOrAdmin();
    }

    // Attendance — only teachers and admins can write
    match /attendance/{document=**} {
      allow read: if isAuth();
      allow write: if isTeacherOrAdmin();
    }

    // Fee Structure — accountant reads/writes, others read only
    match /fees/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }

    // Fee Records — DEEP NESTED PATH SUPPORT
    match /feeRecords/{year}/months/{month}/classes/{classId}/records/{recordId} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }

    // Notices — public read
    match /notices/{document=**} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Settings
    match /settings/{document=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getUserRole() == 'admin';
    }

    // Gallery
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Transport
    match /transport/{document=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getUserRole() in ['admin', 'supervisor'];
    }

    // Exams and Results
    match /exams/{document=**} {
      allow read: if isAuth();
      allow write: if isTeacherOrAdmin();
    }
    match /results/{document=**} {
      allow read: if isAuth();
      allow write: if isTeacherOrAdmin();
    }

    // Classes and subjects
    match /classes/{document=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getUserRole() == 'admin';
    }
    match /classSubjects/{document=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getUserRole() == 'admin';
    }
    match /class_teachers/{document=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getUserRole() == 'admin';
    }

    // Teachers
    match /teachers/{document=**} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Admissions — authenticated users can submit, only admin can modify
    match /admissions/{document=**} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Admission Requests — public can submit (from website form), admin reads/writes
    match /admission_requests/{document=**} {
      allow read: if isAuth();
      allow create: if true;
      allow update, delete: if isAuth() && getUserRole() == 'admin';
    }

    // Job Applications — public can submit, admin reads/manages
    match /job_applications/{document=**} {
      allow read: if isAuth();
      allow create: if true;
      allow update, delete: if isAuth() && getUserRole() == 'admin';
    }

    // Default — deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
