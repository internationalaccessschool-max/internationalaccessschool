rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasRole(r) { return isAuth() && getUserRole() == r; }
    function hasAny(roles) { return isAuth() && getUserRole() in roles; }
    function isAdmin() { return hasRole('admin'); }
    function isAccountantOrAdmin() { return hasAny(['admin', 'accountant']); }
    function isTeacherOrAdmin() { return hasAny(['admin', 'teacher']); }
    function isAdminOrSupervisor() { return hasAny(['admin', 'supervisor']); }
    function isStaff() { return hasAny(['admin', 'teacher', 'accountant', 'supervisor']); }

    // ─── Users (core user docs — admin, teacher, accountant, supervisor, student) ──
    match /users/{userId} {
      allow read: if isAuth();
      // Only admin can create new user docs (seeds role). Prevents privilege escalation.
      allow create: if isAdmin();
      // Admin full update; self can update own profile BUT role field must stay same.
      allow update: if isAuth() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // ─── Students: deep-nested under users/classes/.../profiles/{uid} ──────
    // Placeholder/marker docs at intermediate levels
    match /users/classes/{className}/{path=**} {
      allow read: if isAuth();
      allow write: if isStaff();
    }
    // Ensure profiles (collectionGroup) readable for any auth user
    match /{path=**}/profiles/{profileId} {
      allow read: if isAuth();
      allow write: if isStaff();
    }

    // ─── Role lookup collections ───────────────────────────────────────────
    match /admins/{document=**}      { allow read: if isAuth(); allow write: if isAdmin(); }
    match /accountants/{document=**} { allow read: if isAuth(); allow write: if isAdmin(); }
    match /supervisors/{document=**} { allow read: if isAuth(); allow write: if isAdmin(); }
    match /teachers/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Students flat collection (legacy / lookup) ───────────────────────
    match /students/{document=**} {
      allow read: if isAuth();
      allow write: if isStaff();
    }

    // ─── Student Lookup (uid → class/section cache) ───────────────────────
    match /studentLookup/{uid} {
      allow read: if isAuth();
      allow write: if isStaff();
    }

    // ─── Academic / Content ────────────────────────────────────────────────
    match /homework/{document=**}         { allow read: if isAuth();  allow write: if isTeacherOrAdmin(); }
    match /attendance/{document=**}       { allow read: if isAuth();  allow write: if isTeacherOrAdmin(); }
    match /notices/{document=**}          { allow read: if true;      allow write: if isTeacherOrAdmin(); }
    match /gallery/{document=**}          { allow read: if true;      allow write: if isStaff(); }
    match /hero-slides/{document=**}      { allow read: if true;      allow write: if isAdmin(); }
    match /academic_info/{document=**}    { allow read: if true;      allow write: if isAdmin(); }
    match /academic_programs/{document=**}{ allow read: if true;      allow write: if isAdmin(); }

    // ─── Settings ──────────────────────────────────────────────────────────
    match /settings/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Classes / Subjects / Assignments ─────────────────────────────────
    match /classes/{document=**}         { allow read: if isAuth(); allow write: if isAdmin(); }
    match /classSubjects/{document=**}   { allow read: if isAuth(); allow write: if isAdmin(); }
    match /class_teachers/{document=**}  { allow read: if isAuth(); allow write: if isAdmin(); }
    match /subjects/{document=**}        { allow read: if isAuth(); allow write: if isAdmin(); }
    match /teacherAssignments/{document=**} {
      allow read: if isAuth();
      allow write: if isTeacherOrAdmin();
    }

    // ─── Exams & Results ───────────────────────────────────────────────────
    match /exams/{document=**}   { allow read: if isAuth(); allow write: if isTeacherOrAdmin(); }
    match /results/{document=**} { allow read: if isAuth(); allow write: if isTeacherOrAdmin(); }

    // ─── Teacher Attendance ────────────────────────────────────────────────
    match /teacherAttendance/{document=**} {
      allow read: if isAuth();
      allow write: if isAdminOrSupervisor();
    }

    // ─── Teacher Salary ────────────────────────────────────────────────────
    // Specific (record-level): teacher reads own; admin full access
    match /teacherSalary/{year}/months/{month}/records/{recordId} {
      allow read: if isAdmin() || (isAuth() && resource.data.teacherId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    // Parent/intermediate traversal
    match /teacherSalary/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Fee Structure ─────────────────────────────────────────────────────
    match /fees/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }
    match /feeStructure/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Monthly Fee Records (nested) ──────────────────────────────────────
    match /feeRecords/{year}/months/{month}/classes/{classId}/records/{recordId} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }
    // Parent traversal + collectionGroup("records")
    match /feeRecords/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Annual Fee Records ────────────────────────────────────────────────
    match /annualFeeRecords/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Transport ─────────────────────────────────────────────────────────
    match /transport/{document=**} {
      allow read: if isAuth();
      allow write: if hasAny(['admin', 'supervisor', 'accountant']);
    }
    match /transport_buses/{document=**} {
      allow read: if isAuth();
      allow write: if hasAny(['admin', 'supervisor', 'accountant']);
    }
    match /transportFeeRecords/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }

    // ─── Admissions ────────────────────────────────────────────────────────
    match /admissions/{document=**} {
      allow read: if isAuth();
      allow write: if isAccountantOrAdmin();
    }
    // Public submission from website
    match /admission_requests/{document=**} {
      allow read: if isAuth();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ─── Job Applications (public submit) ──────────────────────────────────
    match /job_applications/{document=**} {
      allow read: if isAuth();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ─── Default deny ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
